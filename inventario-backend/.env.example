# Copiar a ".env" y completar con los datos del proyecto Supabase.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
SUPABASE_BUCKET=disfraces

PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Origen permitido para CORS (ej: https://usuario.github.io)
CORS_ORIGIN=*

IMG_MAX_SIZE=1600
IMG_QUALITY=80
