# Copiar este archivo a ".env" y completar con los datos de tu proyecto Supabase.
# NO subir el archivo .env al repositorio.

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
SUPABASE_ANON_KEY=tu-anon-key

# Bucket de Storage donde se suben las fotos
SUPABASE_BUCKET=disfraces

# Tamano maximo (px) del lado mayor y calidad WebP de las fotos subidas
IMG_MAX_SIZE=1600
IMG_QUALITY=80
